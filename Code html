<!DOCTYPE html>
<html lang="ms">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>MRSM SmartLife</title>

<style>

/* =========================
   ASAS
========================= */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
}

body {
    background: #f5f0ff;
    color: #241633;
    padding-bottom: 90px;
}


/* =========================
   HEADER
========================= */

.header {
    background: linear-gradient(135deg, #4b168c, #8a42d6);
    color: white;
    padding: 25px 20px 30px;
    border-radius: 0 0 30px 30px;
    box-shadow: 0 5px 20px rgba(90, 40, 150, 0.25);
}

.header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    width: 55px;
    height: 55px;
    background: white;
    color: #6622a0;
    border-radius: 18px;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 30px;
}

.header h1 {
    font-size: 25px;
    margin-bottom: 5px;
}

.header p {
    font-size: 14px;
    opacity: 0.9;
}


/* =========================
   PAGE
========================= */

.page {
    display: none;
    padding: 20px;
    max-width: 650px;
    margin: auto;
}

.page.active {
    display: block;
}


/* =========================
   WELCOME CARD
========================= */

.welcome {
    background: white;
    margin-top: -10px;
    padding: 20px;
    border-radius: 20px;
    box-shadow: 0 5px 18px rgba(60,30,100,0.08);
}

.welcome h2 {
    color: #6423a2;
    margin-bottom: 7px;
}


/* =========================
   SECTION TITLE
========================= */

.section-title {
    margin: 25px 0 15px;
    color: #4e197e;
}


/* =========================
   MENU GRID
========================= */

.menu-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
}

.menu-button {
    border: none;
    background: white;
    padding: 20px 12px;
    border-radius: 20px;
    text-align: left;
    box-shadow: 0 5px 15px rgba(70,30,100,0.08);
    cursor: pointer;
    transition: 0.2s;
}

.menu-button:hover {
    transform: translateY(-4px);
}

.menu-icon {
    width: 50px;
    height: 50px;
    background: #eee1ff;
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
    margin-bottom: 12px;
}

.menu-button h3 {
    color: #4d197c;
    margin-bottom: 5px;
}

.menu-button p {
    color: #777;
    font-size: 12px;
}


/* =========================
   ANNOUNCEMENT
========================= */

.announcement {
    background: white;
    padding: 18px;
    border-radius: 18px;
    margin-bottom: 12px;
    box-shadow: 0 4px 12px rgba(60,30,100,0.07);
}

.announcement h3 {
    color: #5b2091;
    margin-bottom: 8px;
}

.announcement p {
    color: #555;
    line-height: 1.5;
}

.date {
    display: block;
    margin-top: 8px;
    font-size: 12px;
    color: #9270aa;
}


/* =========================
   PAGE TITLE
========================= */

.page-title {
    margin-bottom: 20px;
}

.page-title h2 {
    color: #541b88;
    font-size: 24px;
}

.page-title p {
    color: #777;
    margin-top: 5px;
}


/* =========================
   JADUAL
========================= */

select,
input {
    width: 100%;
    padding: 14px;
    border: 1px solid #ddd;
    border-radius: 12px;
    background: white;
    margin: 8px 0 18px;
    font-size: 15px;
}

.schedule {
    background: white;
    padding: 10px;
    border-radius: 18px;
    overflow: hidden;
}

table {
    width: 100%;
    border-collapse: collapse;
}

th {
    background: #6b29a4;
    color: white;
    padding: 13px;
    text-align: left;
}

td {
    padding: 13px;
    border-bottom: 1px solid #eee;
}

td:first-child {
    color: #6423a2;
    font-weight: bold;
}


/* =========================
   MENU MAKANAN
========================= */

.food {
    background: white;
    padding: 18px;
    border-radius: 18px;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 15px;
    box-shadow: 0 4px 12px rgba(60,30,100,0.07);
}

.food-icon {
    font-size: 35px;
}

.food h3 {
    color: #5a218d;
    margin-bottom: 5px;
}


/* =========================
   KEHADIRAN
========================= */

.form-card {
    background: white;
    padding: 20px;
    border-radius: 20px;
    box-shadow: 0 4px 15px rgba(60,30,100,0.08);
}

.form-card label {
    display: block;
    font-weight: bold;
    margin-top: 8px;
}

.radio-box {
    display: flex;
    gap: 10px;
    margin: 10px 0 20px;
}

.radio-box label {
    background: #f2e9ff;
    padding: 12px;
    border-radius: 10px;
    font-weight: normal;
    flex: 1;
}

.submit {
    width: 100%;
    padding: 15px;
    border: none;
    border-radius: 12px;
    background: linear-gradient(135deg,#5b1b91,#8a42d6);
    color: white;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
}


/* =========================
   AKTIVITI
========================= */

.activity {
    background: white;
    padding: 18px;
    border-radius: 18px;
    display: flex;
    gap: 15px;
    align-items: center;
    margin-bottom: 12px;
}

.activity-icon {
    font-size: 40px;
}

.activity h3 {
    color: #5b218e;
    margin-bottom: 6px;
}


/* =========================
   PROFIL
========================= */

.profile {
    background: white;
    padding: 30px 20px;
    border-radius: 22px;
    text-align: center;
}

.profile-icon {
    width: 85px;
    height: 85px;
    background: #eadbff;
    border-radius: 50%;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 45px;
}

.profile h2 {
    color: #5b208d;
    margin: 15px 0 5px;
}

.profile-info {
    background: #f5efff;
    padding: 15px;
    margin-top: 20px;
    border-radius: 15px;
    text-align: left;
}

.profile-info p {
    padding: 8px 0;
}


/* =========================
   BOTTOM NAVIGATION
========================= */

.bottom-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 75px;
    background: white;
    display: flex;
    justify-content: space-around;
    align-items: center;
    box-shadow: 0 -5px 20px rgba(60,30,100,0.12);
    z-index: 999;
}

.bottom-nav button {
    border: none;
    background: none;
    color: #777;
    cursor: pointer;
    font-size: 21px;
}

.bottom-nav button.active {
    color: #6524a0;
}

.bottom-nav span {
    display: block;
    font-size: 10px;
    margin-top: 4px;
}


/* =========================
   RESPONSIVE
========================= */

@media(max-width:400px) {

    .header h1 {
        font-size: 21px;
    }

    .menu-grid {
        gap: 10px;
    }

}

</style>
</head>


